# ============================================================
# 새모양 F&B 경비관리 시스템 환경변수
# 이 파일을 복사해 .env.local 로 저장하고 실제 값을 입력하세요.
# .env.local 은 .gitignore 처리되어 GitHub에 올라가지 않습니다.
# ============================================================

# ── NextAuth 설정 ──────────────────────────────────────────
# 랜덤 시크릿: openssl rand -base64 32 로 생성 (또는 아무 랜덤 문자열)
NEXTAUTH_SECRET=your_random_secret_here
# Vercel 배포 시에는 NEXTAUTH_URL 미설정 (자동 감지)
# 로컬 개발 시에만 설정
NEXTAUTH_URL=http://localhost:3000

# ── Google OAuth ───────────────────────────────────────────
# Google Cloud Console → OAuth 2.0 클라이언트 ID
# 앱 공개 상태 + 기본 스코프만 사용 → 심사 없이 누구나 로그인 가능
# 승인된 리디렉션 URI:
#   http://localhost:3000/api/auth/callback/google
#   https://[your-vercel-domain]/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 카카오 OAuth (선택) ────────────────────────────────────
# developers.kakao.com → 앱 → REST API 키
# 카카오 로그인 Redirect URI:
#   http://localhost:3000/api/auth/callback/kakao
#   https://[your-vercel-domain]/api/auth/callback/kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ── 이메일 발송용 SMTP (회사 공용 메일 1개만 설정) ──────────
# 로그인 사용자가 누구든 이 계정으로 발송되고, Reply-To는 사용자 이메일로 설정됨
SMTP_SERVER=smtp.naver.com
SMTP_PORT=587
SMTP_USER=your_company_email@naver.com
SMTP_PASSWORD=your_app_password

# ── OCR API ───────────────────────────────────────────────
# https://ocr.space 에서 무료 발급 (무료 키: helloworld)
OCR_SPACE_API_KEY=helloworld

# ── 로그인 허용 이메일 (B안: 화이트리스트) ──────────────────
# 콤마(,)로 구분해 여러 이메일 지정 가능
# 비워두면 모든 이메일 허용 (로컬 개발 시 편의)
# 예) ALLOWED_EMAILS=admin@company.com,staff@company.com
ALLOWED_EMAILS=
