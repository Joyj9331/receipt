# ======================================
# 새모양 F&B 경비관리 시스템 환경변수
# 이 파일을 복사해 .env.local 로 저장하고 실제 값을 입력하세요
# .env.local 은 절대 GitHub에 올라가지 않습니다 (.gitignore 처리됨)
# ======================================

# OCR API Key (https://ocr.space 에서 무료 발급)
OCR_SPACE_API_KEY=helloworld

# 이메일 발송 설정
SMTP_SERVER=smtp.naver.com
SMTP_PORT=587
SENDER_EMAIL=your_email@naver.com
SENDER_PASSWORD=your_app_password
RECEIVER_EMAIL=receiver_email@naver.com
